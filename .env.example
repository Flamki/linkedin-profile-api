# Required: the value of the authenticated LinkedIn `li_at` cookie.
LINKEDIN_LI_AT=replace-me

# Optional: improves compatibility with LinkedIn's internal Voyager API.
# Keep the surrounding quotes if they are part of the cookie value.
LINKEDIN_JSESSIONID=

# Optional: when set, clients must send this value in X-API-Key.
API_KEY=

HEADLESS=true
PORT=8000
REQUEST_TIMEOUT_SECONDS=60
MAX_CONCURRENT_SCRAPES=2
RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
